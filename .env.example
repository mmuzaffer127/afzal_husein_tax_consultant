# Environment Variables — Afzal Husein Mohtesham Website
# Copy this file to .env and fill in the values

# Server
NODE_ENV=development
PORT=5000

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://username:password@localhost:5432/afzal_husein_db

# Session Secret (use a long random string in production)
SESSION_SECRET=change-this-to-a-random-secret-in-production

# Initial Admin Account (used by seed script)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-this-secure-password

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Gemini API Key (for admin AI features)
# GEMINI_API_KEY=
